{
  "name": "elmonte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names 'web,api' --prefix-colors 'cyan,magenta' 'npm --prefix frontend run dev' 'python3 -m uvicorn api.main:app --app-dir backend --port 8000 --reload --reload-dir backend'",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "python3 -m uvicorn api.main:app --app-dir backend --port 8000 --reload --reload-dir backend",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test && python3 -m pytest",
    "test:web": "npm --prefix frontend test",
    "test:api": "python3 -m pytest",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "db:ping": "bash backend/scripts/db/ping.sh",
    "db:setup": "bash backend/scripts/db/setup.sh",
    "db:schema": "SKIP_SEED=1 bash backend/scripts/db/setup.sh",
    "db:migrate": "cd backend && python3 -m alembic upgrade head",
    "db:migrate:down": "cd backend && python3 -m alembic downgrade -1",
    "db:migrate:status": "cd backend && python3 -m alembic current",
    "db:revision": "cd backend && python3 -m alembic revision --autogenerate -m",
    "test:live": "python3 -m pytest backend/tests_live -q",
    "test:e2e": "python3 -m pytest e2e -q",
    "db:integrity": "cd backend && python3 -m scripts.admin.integrity_check",
    "db:integrity:fix": "cd backend && python3 -m scripts.admin.integrity_check --fix",
    "backfill:institutions": "cd backend && python3 -m scripts.backfill.openalex_institutions"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
