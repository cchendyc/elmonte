# Neon Postgres connection string (Dashboard → Connect → Connection string)
# Use the "pooled" URL (host contains -pooler) for the app: PgBouncer in
# transaction mode, ~10k concurrent connections.  Keep channel_binding=require
# — psycopg3 and libpq ≥ 13 both speak SCRAM channel binding.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct URL (host WITHOUT -pooler, port 5432) — for migrations, psql and
# one-shot data pipelines (alembic, scripts/db/*.sh and the backfills all use
# it when set).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require"

# Test database on Neon — the pytest suite runs against this, never the app DB.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech:5432/neondb_test?sslmode=require&channel_binding=require"

# ID obfuscation salt (optional — a dev default is used when unset with a warning).
# This provides obscurity, NOT cryptographic security — IDs remain guessable so
# unauthenticated link-sharing works. See api/id_codec.py for details.
# Changing this value will invalidate all previously-generated public IDs.
# In production (ELMONTE_ENV=production) the app refuses to start without it.
# ELMONTE_ID_SALT="your-random-salt-here"
#
# Deployment environment; when set to "production", ELMONTE_ID_SALT becomes
# mandatory and the dev-salt fallback is refused.
# ELMONTE_ENV="development"
#
# OpenAlex API key (https://openalex.org/settings/api) — required for publication backfill
OPENALEX_API_KEY="your-key-here"

# Render API only — comma-separated browser origins allowed to call the API.
# CORS_ORIGINS="https://YOUR_USER.github.io,https://YOUR_USER.github.io/elmonte"

# GitHub Pages build (set in repo Actions variables, not .env):
# VITE_API_URL="https://elmonte-api.onrender.com/api"
# VITE_BASE_PATH="/elmonte/"
